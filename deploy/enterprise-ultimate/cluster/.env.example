# ============================================================
# FoodFlow 企业版 - 集群部署环境变量
# 适用：多商户/SaaS平台，200+家门店，可水平扩展
# 部署位置：/etc/foodflow/.env
# ============================================================

# ---------- 基础配置 ----------
PORT=3000
NODE_ENV=production
APP_VERSION=enterprise

# ---------- 数据库配置（MySQL高可用版或云RDS） ----------
DB_HOST=mysql-enterprise.example.com
DB_PORT=3306
DB_NAME=foodflow_enterprise_ultimate
DB_USER=foodflow
DB_PASSWORD=YourStrongPasswordHere
DB_CONNECTION_LIMIT=100

# ---------- Redis 配置（企业版必须，主从架构） ----------
REDIS_URL=redis://:redis_password@redis-enterprise.example.com:6379/0

# ---------- 上传目录配置（对象存储或NFS共享） ----------
UPLOAD_DIR=/mnt/shared/uploads

# ---------- 定时任务配置（只在主节点设置true） ----------
RUN_SCHEDULED_TASKS=true

# ---------- 企业版特有配置 ----------
# 超级管理员后台路径
SUPER_ADMIN_PATH=/super
# 商户编码前缀
MERCHANT_CODE_PREFIX=FF
# 是否允许商户自助注册
ALLOW_MERCHANT_REGISTRATION=false
# 单商户最大门店数（0表示不限制）
MAX_STORES_PER_MERCHANT=0

# ---------- 业务配置 ----------
QR_DOMAIN=https://your-domain.com
DEFAULT_CURRENCY=USD
JWT_SECRET=ChangeThisToARandomStringForEnterprise
TOKEN_EXPIRE_HOURS=24

# ---------- 日志配置 ----------
LOG_LEVEL=info
LOG_DIR=/var/www/foodflow/logs
