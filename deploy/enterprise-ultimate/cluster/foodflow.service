# ============================================================
# FoodFlow 企业版 - 集群部署 Systemd 服务配置
# 部署位置：/etc/systemd/system/foodflow.service
# ============================================================

[Unit]
Description=FoodFlow Enterprise - Cluster Node
After=network.target nfs-client.target
Wants=network.target nfs-client.target

[Service]
Type=simple
User=www-data
Group=www-data

WorkingDirectory=/var/www/foodflow
EnvironmentFile=/etc/foodflow/.env

ExecStart=/usr/bin/node server.js

Restart=always
RestartSec=5

# 企业版资源限制（建议4核8GB以上）
LimitNOFILE=131072
LimitNPROC=8192
MemoryMax=14G
MemoryHigh=12G
CPUShares=1024

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/foodflow/logs /mnt/shared/uploads
ReadOnlyPaths=/var/www/foodflow

StandardOutput=journal
StandardError=journal
SyslogIdentifier=foodflow

[Install]
WantedBy=multi-user.target
