# ============================================================
# FoodFlow 标准版 - 集群部署环境变量
# 适用：单个餐饮品牌，50-100家门店，多台应用服务器
# 部署位置：/etc/foodflow/.env
# ============================================================

# ---------- 基础配置 ----------
PORT=3000
NODE_ENV=production
APP_VERSION=standard

# ---------- 数据库配置（独立MySQL或云RDS） ----------
DB_HOST=mysql-internal.example.com
DB_PORT=3306
DB_NAME=foodflow_enterprise
DB_USER=foodflow
DB_PASSWORD=YourStrongPasswordHere
DB_CONNECTION_LIMIT=80

# ---------- Redis 配置（集群部署必须） ----------
REDIS_URL=redis://:redis_password@redis-internal.example.com:6379/0

# ---------- 上传目录配置（NFS共享存储） ----------
UPLOAD_DIR=/mnt/shared/uploads

# ---------- 定时任务配置（只在主节点设置true） ----------
RUN_SCHEDULED_TASKS=true

# ---------- 业务配置 ----------
QR_DOMAIN=https://your-domain.com
DEFAULT_CURRENCY=USD
JWT_SECRET=ChangeThisToARandomStringForStandard
TOKEN_EXPIRE_HOURS=24

# ---------- 日志配置 ----------
LOG_LEVEL=info
LOG_DIR=/var/www/foodflow/logs
