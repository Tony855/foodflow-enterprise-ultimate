# ============================================================
# FoodFlow 点餐系统 - 单台部署环境变量
# 适用：1-50家门店，所有服务在一台服务器
# 部署位置：/etc/foodflow/.env
# ============================================================

# ---------- 基础配置 ----------
PORT=3000
NODE_ENV=production

# ---------- 数据库配置（MySQL，本机） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=foodflow_standard
DB_USER=foodflow
DB_PASSWORD=YourStrongPasswordHere
DB_CONNECTION_LIMIT=50

# ---------- Redis 配置（可选，不配置则使用内存缓存） ----------
# REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 上传目录配置（本地目录） ----------
UPLOAD_DIR=/var/www/foodflow/uploads

# ---------- 定时任务配置 ----------
RUN_SCHEDULED_TASKS=true

# ---------- 业务配置 ----------
QR_DOMAIN=https://your-domain.com
DEFAULT_CURRENCY=USD
JWT_SECRET=ChangeThisToARandomString
TOKEN_EXPIRE_HOURS=24

# ---------- 日志配置 ----------
LOG_LEVEL=info
LOG_DIR=/var/www/foodflow/logs
